{
  "info": {
    "name": "MoneyBack OS backend T20\u2013T25",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Backend-only sandbox demo. Select individual requests as documented in DEMO.md; do not run the entire collection unattended. Set your private accessToken and sandbox IDs. Potential savings require verified evidence; refunds are simulated only."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
