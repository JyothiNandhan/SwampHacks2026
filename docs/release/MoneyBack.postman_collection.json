    {
      "key": "baseUrl",
      "value": "https://swamphacks2026-production.up.railway.app"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "originalFileId",
      "value": ""
    },
    {
      "key": "receiptId",
      "value": ""
