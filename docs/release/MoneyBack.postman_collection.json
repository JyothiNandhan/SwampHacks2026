  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const result = pm.response.json();",
              "  pm.test(\"API is healthy\", function () { pm.expect(result.status).to.eql(\"ok\"); });",
              "}"
            ]
          }
        }
      ]
    },
