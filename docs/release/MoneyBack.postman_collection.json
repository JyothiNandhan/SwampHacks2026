    {
      "name": "POST /documents",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/documents",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mimeType\": \"text/plain\",\n  \"contentBase64\": \"U1lOVEhFVElDIFJFQ0VJUFQ=\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const result = pm.response.json();",
              "  pm.collectionVariables.set(\"originalFileId\", result.data.originalFileId);",
              "  pm.collectionVariables.set(\"documentChecksum\", result.data.checksum);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /documents/:originalFileId",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/documents/{{originalFileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const result = pm.response.json();",
              "  pm.test(\"Original checksum is unchanged\", function () { pm.expect(result.data.checksum).to.eql(pm.collectionVariables.get(\"documentChecksum\")); });",
              "}"
            ]
          }
        }
      ]
    },
