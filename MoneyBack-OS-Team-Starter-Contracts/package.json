{
  "name": "moneyback-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.16.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "check:versions": "node scripts/check-versions.mjs",
    "check": "pnpm check:versions && pnpm check:contracts && pnpm -r --if-present typecheck && pnpm -r --if-present test",
    "dev:api": "pnpm --filter @moneyback/api dev",
    "dev:worker": "pnpm --filter @moneyback/worker dev",
    "init:lock": "pnpm install --lockfile-only",
    "check:contracts": "node scripts/check-contracts.mjs"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:",
    "@types/node": "catalog:"
  }
}
