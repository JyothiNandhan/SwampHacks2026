# Shared environment variable NAMES. Values are local secrets; never commit .env.
NODE_ENV=development
PORT=3001
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
DATABASE_URL=
GEMINI_API_KEY=
SERPAPI_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_AMAZON_DATASET_ID=
BRIGHTDATA_WALMART_DATASET_ID=
INTERNAL_API_URL=http://localhost:3001
INTERNAL_WORKER_TOKEN=
WORKER_POLL_MS=2000
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Future web/client config, no API secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Provisioned opaque per-user credentials: hashes only; see docs/release/HANDOFF.md.
API_TOKENS_JSON=[]
EVIDENCE_DIRECTORY=/data/evidence
GEMINI_MODEL=
PRICE_MONITOR_MODE=LIVE
WORKER_SCHEDULE_ENABLED=false

# Optional local launch setting; Railway Docker image supplies its absolute CA path.
# NODE_EXTRA_CA_CERTS must be set before starting Node.
NODE_EXTRA_CA_CERTS=
