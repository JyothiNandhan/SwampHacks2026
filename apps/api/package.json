{
  "name": "@moneyback/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "jose": "catalog:",
    "fastify": "catalog:",
    "@google/genai": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:",
    "@moneyback/contracts": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "@types/pg": "catalog:"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example:gate2": "pnpm build && node dist/examples/run-gate2.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "evaluate:receipts": "tsx src/evaluation/run.ts",
    "test:release": "vitest run src/integration/backend.test.ts src/integration/security.test.ts",
    "operator": "tsx src/integration/operator.ts"
  }
}
